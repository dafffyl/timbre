        }
      }
    },
    "Le texte du transcript est envoyé à Groq (même clé que la transcription) pour rédiger un compte rendu selon tes instructions.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The transcript text is sent to Groq (same key as transcription) to write a report following your instructions."
